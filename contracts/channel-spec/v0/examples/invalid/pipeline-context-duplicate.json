{
  "apiVersion": "tributary.dev/v1",
  "kind": "Channel",
  "metadata": {
    "name": "adt-to-fhir-stub",
    "description": "Invalid: pipeline.context names the same capability twice. Synthetic only."
  },
  "spec": {
    "ordering": "none",
    "source": {
      "type": "mllp",
      "bind": "127.0.0.1",
      "port": 6661,
      "ack": { "mode": "after-commit", "nackOn": ["parse-error", "queue-full"] }
    },
    "pipeline": {
      "bundle": "ghcr.io/tributary-synth/adt-integration@sha256:3f7a1c9e2b5d48a06e1f8c3d7b2a95e04c6d8f1a3b5c7d9e0f2a4b6c8d0e2f46",
      "context": ["fhir", "fhir"],
      "steps": [
        { "name": "parse", "uses": "tributary.hl7v2.parse" },
        { "name": "to-bundle", "uses": "tributary.content_hl7_fhir.adt" }
      ]
    },
    "destinations": [
      {
        "name": "http-stub",
        "type": "http",
        "with": { "url": "http://127.0.0.1:8080/ingest", "method": "POST", "timeoutMs": 5000 },
        "idempotency": { "technique": "none", "note": "Test stub counts deliveries; duplicates are the assertion, not a defect." },
        "retry": { "policy": "blocking", "maxAttempts": 5, "onExhaust": "halt-partition" }
      }
    ]
  }
}
