{
  "apiVersion": "tributary.dev/v1",
  "kind": "Channel",
  "metadata": { "name": "lab-file-relay" },
  "spec": {
    "ordering": "none",
    "source": {
      "type": "sftp",
      "contentType": "application/hl7-v2+er7",
      "ack": { "mode": "after-commit" },
      "sftp": {
        "host": "sftp.partner.example.org",
        "auth": { "type": "private-key", "secretRef": "partner-sftp" },
        "directory": "/outbound/lab",
        "filePattern": "*.hl7",
        "pollIntervalSeconds": 30,
        "afterCommit": "delete",
        "rejectDirectory": "/outbound/lab/rejected"
      }
    },
    "pipeline": {
      "bundle": "ghcr.io/tributary-synth/adt-integration@sha256:3f7a1c9e2b5d48a06e1f8c3d7b2a95e04c6d8f1a3b5c7d9e0f2a4b6c8d0e2f46",
      "steps": [{ "name": "passthrough", "uses": "tributary.core.passthrough" }]
    },
    "destinations": [
      {
        "name": "http-stub",
        "type": "http",
        "with": { "url": "http://127.0.0.1:8081/ingest", "method": "POST", "timeoutMs": 5000 },
        "idempotency": { "technique": "none", "note": "Test stub." },
        "retry": { "policy": "blocking", "maxAttempts": 5, "onExhaust": "halt-partition" }
      }
    ]
  }
}
