{
  "apiVersion": "tributary.dev/v1",
  "kind": "Channel",
  "metadata": {
    "name": "lab-normalise",
    "description": "Set 1.6: an engine step plus a customer step from a fictional distribution, bound by pipeline.stepNamespaces. Synthetic only."
  },
  "spec": {
    "ordering": "none",
    "source": {
      "type": "mllp",
      "bind": "127.0.0.1",
      "port": 6662,
      "ack": { "mode": "after-commit", "nackOn": ["parse-error", "queue-full"] }
    },
    "pipeline": {
      "bundle": "ghcr.io/tributary-synth/lab-integration@sha256:3f7a1c9e2b5d48a06e1f8c3d7b2a95e04c6d8f1a3b5c7d9e0f2a4b6c8d0e2f46",
      "stepNamespaces": { "acme.lab": "acme-lab-steps" },
      "steps": [
        { "name": "parse", "uses": "tributary.hl7v2.parse" },
        { "name": "normalise-units", "uses": "acme.lab.normalise_units" }
      ]
    },
    "destinations": [
      {
        "name": "http-stub",
        "type": "http",
        "with": {
          "url": "http://127.0.0.1:8080/ingest",
          "method": "POST",
          "timeoutMs": 5000
        },
        "idempotency": {
          "technique": "none",
          "note": "Illustrative loopback stub; duplicates are counted, not suppressed."
        },
        "retry": { "policy": "blocking", "maxAttempts": 5, "onExhaust": "halt-partition" }
      }
    ]
  }
}
