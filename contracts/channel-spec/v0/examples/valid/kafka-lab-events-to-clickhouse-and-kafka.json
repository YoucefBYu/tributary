{
  "apiVersion": "tributary.dev/v1",
  "kind": "Channel",
  "metadata": {
    "name": "lab-event-bridge",
    "labels": { "domain": "oru" },
    "description": "Consumes a lab system's topic on another cluster, loads rows into ClickHouse and republishes to a partner cluster. Synthetic only."
  },
  "spec": {
    "ordering": "per-key",
    "partitionKey": "record:key",
    "source": {
      "type": "kafka",
      "contentType": "application/json",
      "ack": { "mode": "after-commit", "nackOn": ["parse-error"] },
      "maxMessageBytes": 1000000,
      "kafka": {
        "connection": {
          "bootstrapServers": ["kafka-1.lab.example.org:9093", "kafka-2.lab.example.org:9093"],
          "security": {
            "protocol": "SASL_SSL",
            "saslMechanism": "SCRAM-SHA-512",
            "secretRef": "lab-kafka-scram",
            "tls": { "secretRef": "lab-kafka-ca", "minVersion": "1.2" }
          }
        },
        "topic": "lab.results.v1",
        "startFrom": "earliest"
      }
    },
    "pipeline": {
      "bundle": "ghcr.io/tributary-synth/lab-integration@sha256:a1b2c3d4e5f60718293a4b5c6d7e8f900a1b2c3d4e5f60718293a4b5c6d7e8f9",
      "steps": [{ "name": "normalise", "ref": "lab_flow.mapping.normalise_result" }]
    },
    "destinations": [
      {
        "name": "lab-analytics",
        "type": "clickhouse",
        "steps": [{ "name": "to-row", "ref": "lab_flow.mapping.to_result_row" }],
        "with": {
          "host": "clickhouse.example.org",
          "port": 9440,
          "database": "analytics",
          "table": "lab_results",
          "auth": { "type": "client-certificate", "secretRef": "clickhouse-lab" },
          "tls": { "mode": "verify-full", "secretRef": "clickhouse-lab" },
          "timeoutMs": 5000
        },
        "idempotency": { "technique": "sink-native", "note": "ReplacingMergeTree ORDER BY tb_msg_id; readers query with FINAL" },
        "retry": { "policy": "blocking", "maxAttempts": 20, "onExhaust": "halt-partition" }
      },
      {
        "name": "partner-feed",
        "type": "kafka",
        "with": {
          "connection": {
            "bootstrapServers": ["kafka.partner.example.org:9093"],
            "security": { "protocol": "SSL", "tls": { "secretRef": "partner-kafka-mtls" } }
          },
          "topic": "partner.lab-results",
          "key": "preserve",
          "timeoutMs": 10000
        },
        "idempotency": { "technique": "idempotency-key-header", "header": "tb-msg-id" },
        "retry": { "policy": "blocking", "maxAttempts": 10, "onExhaust": "halt-partition" }
      }
    ]
  }
}
