{
  "apiVersion": "tributary.dev/v1",
  "kind": "Channel",
  "metadata": {
    "name": "lab-query",
    "labels": { "domain": "qry", "owner": "integration-team" },
    "description": "Set 1.2 synchronous reply: the sender waits for AA (committed and routed), AE (committed, refused or failed or timed out) or AR (not committed). Synthetic only."
  },
  "spec": {
    "ordering": "per-key",
    "partitionKey": "hl7:PID.3[5:MR].1",
    "source": {
      "type": "mllp",
      "bind": "0.0.0.0",
      "port": 6670,
      "tls": { "secretRef": "lab-query-mllp-tls", "clientAuth": "required", "minVersion": "1.3" },
      "ack": { "mode": "after-commit", "nackOn": ["parse-error", "queue-full"], "timeoutMs": 5000 },
      "maxMessageBytes": 1000000,
      "queue": { "maxBytes": 67108864 },
      "reply": {
        "timeoutMs": 10000,
        "after": "routed",
        "body": "ack",
        "maxPending": 10000,
        "partitions": 3
      }
    },
    "pipeline": {
      "bundle": "ghcr.io/tributary-synth/lab-integration@sha256:a1b2c3d4e5f60718293a4b5c6d7e8f900a1b2c3d4e5f60718293a4b5c6d7e8f9",
      "stepRetries": 3,
      "steps": [
        { "name": "parse", "uses": "tributary.hl7v2.parse" },
        { "name": "to-json", "ref": "lab_flow.mapping.query_to_json" }
      ]
    },
    "destinations": [
      {
        "name": "lab-api",
        "type": "http",
        "with": { "url": "https://lab.example.org/v1/queries", "method": "POST", "timeoutMs": 8000 },
        "idempotency": { "technique": "idempotency-key-header", "header": "Idempotency-Key" },
        "retry": { "policy": "blocking", "backoff": "exponential", "maxAttempts": 10, "onExhaust": "halt-partition" }
      }
    ]
  }
}
