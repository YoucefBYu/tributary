{
  "apiVersion": "tributary.dev/v1",
  "kind": "EngineKafkaConnection",
  "bootstrapServers": ["kafka-0.kafka-brokers.tributary.svc:9093"],
  "security": {
    "protocol": "SASL_SSL",
    "saslMechanism": "SCRAM-SHA-512",
    "secretRef": "tb-worker-adt-to-fhir",
    "tls": { "secretRef": "tb-kafka-ca", "verifyHostname": false }
  }
}
