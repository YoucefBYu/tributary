{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "auto",
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv sync*)",
      "Bash(uv run *)",
      "Bash(uv add *)",
      "Bash(uv lock*)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(pnpm *)",
      "Bash(npm run *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(helm lint*)",
      "Bash(helm template*)",
      "Bash(kubectl --context kind-* *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(jq *)",
      "Bash(mkdir *)",
      "Bash(command *)",
      "Bash(docker *)",
      "Bash(python *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(git push -u origin wave/*)",
      "Bash(git push origin wave/*)",
      "Bash(git -C * status*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * log*)",
      "Bash(git -C * show*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * ls-files*)",
      "Bash(git -C * worktree list*)",
      "Bash(git -C * branch --show-current)",
      "Bash(git fetch *)",
      "Bash(git push origin *:refs/heads/wave/*)",
      "Bash(gh api *)",
      "Bash(helm *)",
      "Bash(python3 *)"
    ],
    "ask": [
      "Bash(uv sync)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(helm delete *)",
      "Bash(helm rollback *)",
      "Bash(helm push *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push * --delete*)",
      "Bash(git push * --mirror*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase*)",
      "Bash(rm -rf *)",
      "Bash(docker system prune*)",
      "Bash(docker compose down -v*)",
      "Bash(sudo *)",
      "Bash(curl * | *)",
      "Bash(wget * | *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push *+*)",
      "Bash(git -C * push * --delete*)",
      "Bash(git -C * push * --mirror*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * clean *)",
      "Bash(git -C * rebase*)",
      "Bash(git -C * checkout *)",
      "Bash(git -C * switch *)",
      "Bash(git -C * stash*)",
      "Read(.mypy_cache/**)",
      "Read(.pytest_cache/**)",
      "Read(.venv/**)",
      "Read(node_modules/**)",
      "Read(sbom.cdx.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-content.sh"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/task-completed.sh"
          }
        ]
      }
    ]
  }
}
